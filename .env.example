# Supabase Auth.
# Dashboard > Project Settings > API Keys.
# Usa la publishable key (sb_publishable_...), NO la anon legacy: Supabase la
# deprecara a finales de 2026. Nunca pongas aqui la secret key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base URL de PragmaCRM-Api.
# Emulador Android (AVD): http://10.0.2.2:3000  <- localhost dentro del emulador es el emulador mismo
# Simulador iOS: http://localhost:3000
# Dispositivo fisico en LAN: http://<ip-de-tu-mac>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Debe coincidir con API_KEY del .env de PragmaCRM-Api.
# Compuerta de transporte, no un secreto: se inlinea en el bundle.
# No dejes aqui un valor real ni una URL de tunel: .env.example se versiona.
EXPO_PUBLIC_API_KEY=your-api-key

# Google Cloud Console > APIs & Services > Credentials.
# Sin prefijo EXPO_PUBLIC_ a proposito: es de build, no de runtime, y se
# hornea directo en AndroidManifest.xml durante el prebuild. El prefijo la
# inlinearia ademas en el bundle de JS, sin ningun beneficio (ya queda
# embebida en el APK de todas formas). Solo aplica a Android: expo-maps usa
# MapKit en iOS, que no necesita key.
# Restringila en Google Cloud por nombre de paquete (com.kevrodrguez.PragmaCRMMobile)
# + huella SHA-1 del certificado de firma, nunca la dejes sin restricciones.
GOOGLE_MAPS_API_KEY=AIza...
